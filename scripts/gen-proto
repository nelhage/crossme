#!/bin/bash
#
# Regenerates the Go and TypeScript protobuf/Connect bindings. Needs `buf`
# (https://buf.build/docs/installation) plus the following plugins on $PATH:
#
#   protoc-gen-go
#       go install google.golang.org/protobuf/cmd/protoc-gen-go@latest
#   protoc-gen-connect-go
#       go install connectrpc.com/connect/cmd/protoc-gen-connect-go@latest
#
# protoc-gen-es comes from client/node_modules, so run `npm ci` in client/
# first. Keep it in step with the `@bufbuild/protobuf` version there.
#
# See buf.gen.yaml for where each plugin's output lands.
set -eu
cd "$(dirname "$0")/.."
exec buf generate
